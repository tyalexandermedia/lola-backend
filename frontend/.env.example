VITE_API_URL=http://127.0.0.1:8000

# ── "See how it works" demo video (optional) ──────────────────────────
# Paste a Loom / YouTube / Vimeo share link (or a direct .mp4 URL) and a
# "See how Lola works" button appears in the homepage hero (and any feature
# that gets its own demo). Until set, the button renders nothing — no dead
# button ever shows. Record a 60-90s Loom and drop the link here.
VITE_EXPLAINER_VIDEO_URL=

# ── Web chat widget (GoHighLevel / LeadConnector) ─────────────────
# Paste the widget id from GHL (Sites → Chat Widget → build → Copy embed →
# the data-widget-id value). A chat bubble then appears site-wide and every
# conversation lands in your GHL Conversations inbox. Until set, NOTHING is
# injected — no bubble, no third-party script (dormant by default, same as the
# GHL webhook and Twilio). See docs/CHANNEL_CONNECT.md.
VITE_GHL_CHAT_WIDGET_ID=
# Optional overrides — leave blank unless GHL moves its endpoints or you're on
# a white-label resource domain. Defaults are the LeadConnector-global URLs.
VITE_GHL_CHAT_LOADER_SRC=
VITE_GHL_CHAT_RESOURCES_URL=

# ── Lola Managed subscription (nurture-destination /managed page) ──
# Stripe SUBSCRIPTION Payment Link for $297/mo. Powers the "Start Lola Managed"
# button on /managed. Until set, that button books a call instead. Keep this
# OFF the public /pricing tiers on purpose — /managed is the continuity page
# the post-build nurture points to, not a cold-traffic offer.
VITE_STRIPE_MANAGED_URL=
