---
import { SITE, val } from '../lib/config';
const steps = val(SITE.process);
---
{steps && steps.length > 0 && (
  <section class="block band" id="process">
    <div class="shell">
      <div class="center">
        <p class="eyebrow">How it works</p>
        <h2>Simple from first call to finished job</h2>
      </div>
      <div class="steps">
        {steps.map((s) => (
          <div class="step">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
