---
import { getCollection } from 'astro:content';
import { BRAND, CTA_PATH, CTA_SHORT, PHONE_HREF, SITE, phoneDisplay } from '../lib/config';
const services = (await getCollection('services', (s) => s.data.enabled))
  .sort((a, b) => a.data.priority - b.data.priority)
  // Three fit at desktop width even with long service names; the rest are one
  // click away on the homepage grid and in the footer.
  .slice(0, 3);
---
<div class="topbar">
  Serving <strong>{SITE.serviceArea.summary}</strong><span class="topbar-extra"> · {SITE.cta.responsePromise}</span>
</div>
<header class="nav">
  <div class="shell nav-inner">
    <a class="brand" href="/" aria-label={`${SITE.publicName} home`}>
      <img src={BRAND.logo} alt={BRAND.logoAlt || `${SITE.publicName} logo`} width="160" height="44" />
    </a>
    <nav class="nav-links" aria-label="Primary">
      {services.map((s) => <a href={`/services/${s.id}`}>{s.data.name}</a>)}
      <a class="nav-phone" href={PHONE_HREF} aria-label={`Call ${SITE.publicName} at ${phoneDisplay()}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"/></svg>
        {phoneDisplay()}
      </a>
      <a class="btn nav-cta" href={CTA_PATH}>{CTA_SHORT}</a>
    </nav>
  </div>
</header>
