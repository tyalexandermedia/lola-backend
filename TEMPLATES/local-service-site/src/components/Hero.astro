---
import { BRAND, PHONE_HREF, PROOF, SITE, hasProof, phoneDisplay, val } from '../lib/config';
import EstimateForm from './EstimateForm.astro';

interface Props {
  eyebrow: string;
  h1: string;
  sub?: string;
  /** Service page: render a compact form with this service preselected. */
  defaultService?: string;
  breadcrumb?: { name: string };
  compact?: boolean;
}
const { eyebrow, h1, sub, defaultService, breadcrumb, compact = false } = Astro.props;
const rating = val(PROOF.googleRating);
const years = val(PROOF.yearsInBusiness);
const trust: string[] = [];
if (rating) trust.push(`${rating.rating.toFixed(1)} stars · ${rating.count} Google reviews`);
if (years) trust.push(`${years} years in business`);
trust.push(...PROOF.certifications.slice(0, 2));
trust.push(...PROOF.guarantees.slice(0, 1));
---
<section class={`hero${val(BRAND.heroImage) ? ' has-image' : ''}${compact ? ' compact' : ''}`}>
  <div class="shell">
    {breadcrumb && (
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">›</span> {breadcrumb.name}</nav>
    )}
    <div class="hero-grid">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h1 set:html={h1} />
        {sub && <p class="hero-sub" set:html={sub} />}
        <div class="hero-ctas">
          <a class="btn" href="#estimate-form">{SITE.cta.label}</a>
          <a class="btn ghost" href={PHONE_HREF} aria-label={`Call ${SITE.publicName} at ${phoneDisplay()}`}>Call {phoneDisplay()}</a>
        </div>
        {trust.length > 0 && (
          <ul class="hero-trust" aria-label="Trust highlights">
            {trust.map((t) => <li>{t}</li>)}
          </ul>
        )}
        {!hasProof.rating && !hasProof.years && trust.length === 0 && (
          <p class="hero-sub" style="margin-top:16px;font-size:15px">{SITE.cta.responsePromise}</p>
        )}
      </div>
      <div class="quote-card" id="estimate">
        <EstimateForm compact defaultService={defaultService} heading={SITE.cta.label} />
      </div>
    </div>
  </div>
</section>
