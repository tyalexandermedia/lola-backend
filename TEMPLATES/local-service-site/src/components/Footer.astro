---
import { getCollection } from 'astro:content';
import { BRAND, PHONE_HREF, SITE, hoursDisplay, phoneDisplay, val } from '../lib/config';
const services = (await getCollection('services', (s) => s.data.enabled)).sort((a, b) => a.data.priority - b.data.priority);
const address = val(SITE.address);
const license = val(SITE.licenseNumber);
const tagline = val(SITE.tagline);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="shell foot-grid">
    <div class="foot-brand">
      <img src={BRAND.logo} alt={BRAND.logoAlt || `${SITE.publicName} logo`} width="145" height="40" />
      {tagline && <p>{tagline}</p>}
      {address && <p>{address.street}, {address.city}, {address.region} {address.postalCode}</p>}
      {license && <p>License #{license}</p>}
    </div>
    <div>
      <h4>Services</h4>
      <ul>
        {services.map((s) => <li><a href={`/services/${s.id}`}>{s.data.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h4>Service area</h4>
      <ul>
        {SITE.serviceArea.cities.map((c) => <li>{c}</li>)}
      </ul>
    </div>
    <div>
      <h4>Contact</h4>
      <ul>
        <li><a href={PHONE_HREF}>{phoneDisplay()}</a></li>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href="/estimate">{SITE.cta.label}</a></li>
        {hoursDisplay().map((h) => <li>{h}</li>)}
      </ul>
    </div>
  </div>
  <div class="shell foot-bottom">
    <span>© {year} {SITE.legalName}</span>
    <span>{SITE.serviceArea.summary}</span>
  </div>
</footer>
