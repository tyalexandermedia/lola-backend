# Secrets live in Vercel → Project → Settings → Environment Variables.
# Never commit real values. Names only.

# GoHighLevel inbound webhook for THIS client's sub-account
# (GHL → Automation → Workflows → new workflow → trigger "Inbound Webhook").
# Leave blank locally to see the "unconfigured" error state.
GHL_WEBHOOK_URL=

# Optional: Resend API key for the plain-text lead notification email.
# Requires a verified sending domain in Resend and a matching
# `notifications.from` in config/integrations.json.
RESEND_API_KEY=

# Set to 1 ONLY when building the master template with its example config.
# A real client build must never set this; the validator refuses example data.
ALLOW_EXAMPLE_CONFIG=
